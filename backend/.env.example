# ==============================================================================
# Echo Backend - Environment Variables Configuration
# ==============================================================================

# Local development only. Production values are managed by EnvHub; see
# docs/ENVHUB_MIGRATION.md. Do not copy this file to the VPS.
NODE_ENV=development
PORT=3001

# Local database and uploaded media paths.
DATABASE_PATH=./data/echo.db
UPLOADS_PATH=./data/uploads

# Optional comma-separated browser origins. Local development permits origins
# when this value is empty; production requires it through EnvHub.
CORS_ORIGIN=http://localhost:5173
