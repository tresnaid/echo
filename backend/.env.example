# ==============================================================================
# Echo Backend - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Production VPS Configuration (/srv/apps/echo/.env)
# ------------------------------------------------------------------------------
# The production .env file must be provisioned once manually on the VPS.
# compose.prod.yml in the repository is the source of truth and is automatically
# synchronized to /srv/apps/echo/compose.yml by GitHub Actions on every release.
# The VPS .env and data/ directories are persistent and never overwritten.

# The version tag of the prebuilt backend container image published to GHCR.
# Updated automatically by GitHub Actions deployment workflow on backend tags.
# Convention: v<major>.<minor>.<patch>-be (e.g. v0.0.1-be, v1.0.0-be)
ECHO_VERSION=v0.0.1-be

# Node runtime environment
NODE_ENV=production
PORT=3001

# Database and media storage paths
# Inside Docker containers, /app/data is mounted to /srv/apps/echo/data on the host.
# For local dev without Docker, defaults to in-memory DB or local ./data directory.
DATABASE_PATH=/app/data/echo.db
UPLOADS_PATH=/app/data/uploads

# Docker Compose Host Port Binding (for VPS compose.yml):
# Defaults to 127.0.0.1:3001 to bind strictly to localhost for reverse proxying.
BACKEND_BIND=127.0.0.1:3001

# CORS_ORIGIN: Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL).
# In production (NODE_ENV=production), requests from unlisted origins are blocked by default.
# Example: CORS_ORIGIN=https://echo.tresnaid.space
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# Local Development Defaults
# ------------------------------------------------------------------------------
# BACKEND_PORT=3001
