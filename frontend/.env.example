# ==============================================================================
# Echo Frontend - Environment Variables Configuration
# ==============================================================================

# VITE_API_URL: Public URL of the backend API server.
# Leave empty for local development proxy (http://localhost:5173 -> http://localhost:3001).
# For production (Vercel), set to your production API URL:
# Example: VITE_API_URL=https://api-echo.tresnaid.space
VITE_API_URL=https://api-echo.tresnaid.space
