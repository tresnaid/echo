# ==============================================================================
# Echo - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Production VPS Backend Configuration (/srv/apps/echo/.env)
# ------------------------------------------------------------------------------
# The version tag of the prebuilt backend container image published to GHCR.
# Updated automatically by the GitHub Actions release workflow on backend tags.
# Example: ECHO_VERSION=v.1.0.0-be
ECHO_VERSION=v.1.0.0-be

# Node runtime environment
NODE_ENV=production
PORT=3001

# Container paths for persistent SQLite database and uploaded media assets.
# Inside Docker containers, /app/data is mounted to /srv/apps/echo/data on the host.
DATABASE_PATH=/app/data/echo.db
UPLOADS_PATH=/app/data/uploads

# Docker Compose Host Port Binding:
# Defaults to 127.0.0.1:3001 to bind strictly to localhost for reverse proxying.
# If direct access is needed prior to reverse proxy setup, set: BACKEND_BIND=0.0.0.0:3001
BACKEND_BIND=127.0.0.1:3001

# CORS_ORIGIN: Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL).
# In production (NODE_ENV=production), requests from unlisted origins are blocked by default.
# Example: CORS_ORIGIN=https://echo-app.vercel.app,http://localhost:5173
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# Frontend Configuration (Vercel Environment Variables / Build-time)
# ------------------------------------------------------------------------------
# VITE_API_URL: Public URL of the backend API server.
# Configure this in your Vercel project environment variables (or .env.production).
# Example: VITE_API_URL=https://api.yourdomain.com (or http://<vps-ip>:3001 if direct)
VITE_API_URL=

# ------------------------------------------------------------------------------
# Local Development Defaults (docker-compose.yml / npm run dev)
# ------------------------------------------------------------------------------
BACKEND_PORT=3001
FRONTEND_PORT=5173
