# ==============================================================================
# Echo - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Server A)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
DATABASE_PATH=./data/echo.db
UPLOADS_PATH=./data/uploads

# CORS_ORIGIN: Comma-separated list of allowed frontend origins.
# In production (NODE_ENV=production), this MUST be explicitly set to the public
# origin(s) of your frontend server(s). If unset in production, cross-origin requests
# are blocked by default for security.
# Example: CORS_ORIGIN=https://echo.yourdomain.com,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ------------------------------------------------------------------------------
# Frontend Configuration (Server B - Built at build-time)
# ------------------------------------------------------------------------------
# VITE_API_URL: Public URL of the backend API server.
# For separate-server deployment (Server A backend, Server B frontend), you MUST
# pass this when building the frontend Docker image or static bundle:
# Example: VITE_API_URL=https://api.echo.yourdomain.com
# For local Docker Compose, defaults to http://localhost:3001
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Docker Compose Port Bindings (Host ports)
# ------------------------------------------------------------------------------
BACKEND_PORT=3001
FRONTEND_PORT=5173
