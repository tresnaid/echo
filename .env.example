# ==============================================================================
# Echo Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Server A)
# ------------------------------------------------------------------------------
# Port for the Express backend API server
PORT=3001

# Environment mode ('development' or 'production')
NODE_ENV=development

# Custom SQLite database file location (defaults to ./data/echo.db)
DATABASE_PATH=./data/echo.db

# Custom media uploads directory (defaults to ./data/uploads)
UPLOADS_PATH=./data/uploads

# Allowed CORS origins for backend (leave empty to allow all, or set your frontend URL)
# Example: CORS_ORIGIN=https://echo.yourdomain.com or CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (Server B)
# ------------------------------------------------------------------------------
# Base URL for the Echo API server.
# When empty, frontend defaults to relative paths (proxy or same-host deployment).
# When frontend is deployed to a separate server, set this to the backend API origin.
# Example: VITE_API_URL=https://api.echo.yourdomain.com
VITE_API_URL=
